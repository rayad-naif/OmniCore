modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["stripe:1.0.0", "paddle:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 5174
externalPort = 3000

[[ports]]
localPort = 8080
externalPort = 80

[[ports]]
localPort = 8081
externalPort = 8081

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
SUPER_ADMIN_EMAIL = "atelier@irofficial.com"
BILLING_PROVIDER = "paddle"
PADDLE_ENVIRONMENT = "production"
PADDLE_GROWTH_PRICE_ID = "pri_01kx952rvcjj9mv8q7tpn08cec"
PADDLE_STARTER_PRICE_ID = "pri_01kwf270vz11366ajjdd5mz2mv"

[userenv.production]
PUBLIC_APP_URL = "https://omnicore.irofficial.com"
