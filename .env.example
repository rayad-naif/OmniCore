# Atelier OmniCore environment template
# Copy this file to .env for an API-only local run. Dashboard and marketing-site
# Vite variables must be supplied at build time. Never commit a populated .env.

# ── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=8080
PUBLIC_APP_URL=https://your-domain.com
ALLOWED_ORIGINS=https://your-domain.com

# ── Database (PostgreSQL 15+ with pgvector) ──────────────────────────────────
DATABASE_URL=postgres://user:password@localhost:5432/omnicore

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_here_min_64_chars
SESSION_SECRET=your_session_secret_here_min_32_chars

# Set to false only for local HTTP development. Use true behind HTTPS.
COOKIE_SECURE=true

# ── AI — Google Gemini ────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Billing — Paddle ─────────────────────────────────────────────────────────
BILLING_PROVIDER=paddle
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=your_paddle_api_key_here
PADDLE_WEBHOOK_SECRET=your_paddle_webhook_secret_here
# Public Paddle.js client token. This is embedded in Vite builds, not a server secret.
VITE_PADDLE_CLIENT_TOKEN=test_your_paddle_client_token_here

# ── Cloudflare R2 (file storage) ─────────────────────────────────────────────
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_bucket_name

# ── Optional platform integrations ────────────────────────────────────────────
SUPER_ADMIN_EMAIL=admin@your-domain.com
PLATFORM_ADMIN_EMAIL=operations@your-domain.com
INBOUND_EMAIL_DOMAIN=inbound.your-domain.com
INBOUND_WEBHOOK_SECRET=your_inbound_webhook_secret
REDIS_URL=redis://localhost:6379
LOG_LEVEL=info

# Dashboard Vite configuration. Use /api when a reverse proxy serves both apps.
VITE_API_URL=/api
