# ═══════════════════════════════════════════════════════════════════════════════
# Atelier OmniCore — environment template
# Copy to .env (local) or artifacts/api-server/.env (deploy.sh / PM2), or enter
# these in your host's dashboard (Render, Docker, …). Never commit real values.
# Full reference with explanations: docs/ENVIRONMENT.md
# ═══════════════════════════════════════════════════════════════════════════════

# ── Core (required) ──────────────────────────────────────────────────────────
NODE_ENV=development                 # production on any real deployment
PORT=5000                            # deploy.sh / Docker use 8080
DATABASE_URL=postgres://user:password@localhost:5432/omnicore
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_here_min_64_chars
GEMINI_API_KEY=your_gemini_api_key_here   # Google AI Studio — AI replies, copilot, rephrase

# ── Public URL, CORS, cookies, proxies ──────────────────────────────────────
PUBLIC_APP_URL=http://localhost:5174 # canonical https:// origin in production (emails, webhooks, OAuth)
ALLOWED_ORIGINS=http://localhost:5174 # comma-separated; defaults to PUBLIC_APP_URL
COOKIE_SECURE=false                  # true behind HTTPS (default true when NODE_ENV=production)
# TRUST_PROXY=loopback, linklocal, uniquelocal   # who may set X-Forwarded-For (real client IPs)
# DATABASE_SSL=                      # auto | disable | no-verify | verify  (see docs/ENVIRONMENT.md)

# ── Super admin (platform owner) ─────────────────────────────────────────────
SUPER_ADMIN_EMAIL=admin@your-domain.com
# First boot only (scripts/migrate.mjs): creates the super admin account if it
# does not exist. Min 12 chars. Remove after signing in and changing it.
# SUPER_ADMIN_PASSWORD=
PLATFORM_ADMIN_EMAIL=operations@your-domain.com  # receives billing-lock alerts

# ── Billing — Paddle (default provider) ─────────────────────────────────────
BILLING_PROVIDER=paddle
PADDLE_ENVIRONMENT=sandbox           # sandbox | production — must match the keys
PADDLE_API_KEY=your_paddle_api_key_here
PADDLE_WEBHOOK_SECRET=your_paddle_webhook_secret_here
# Public Paddle.js token (test_… / live_…), baked into the frontends at BUILD time.
VITE_PADDLE_CLIENT_TOKEN=test_your_paddle_client_token_here
# Optional fallback price IDs per plan slug (plans normally sync from Super Admin → Billing):
# PADDLE_STARTER_PRICE_ID=pri_…
# PADDLE_GROWTH_PRICE_ID=pri_…

# ── File storage — Cloudflare R2 (logos, attachments, PDF exports) ───────────
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_bucket_name

# ── Email ────────────────────────────────────────────────────────────────────
# Outbound SMTP is configured in the app: Super Admin → Platform Email (system
# mail) and per workspace under Email / SMTP.
INBOUND_EMAIL_DOMAIN=inbound.your-domain.com   # brand forwarding addresses
INBOUND_WEBHOOK_SECRET=your_inbound_webhook_secret

# ── Integrations ─────────────────────────────────────────────────────────────
# 32 random bytes (64 hex chars) — encrypts integration secrets at rest.
# openssl rand -hex 32
INTEGRATIONS_ENCRYPTION_KEY=
# INTEGRATIONS_WORKER=true           # false on extra API replicas
# API_RATE_LIMIT_PER_MINUTE=120      # REST API v1, per key
# WEBHOOKS_ALLOW_HTTP=false          # allow http:// webhook URLs in production
# WEBHOOKS_ALLOW_PRIVATE=false       # allow webhooks to private IPs (never on shared hosting)

# GoHighLevel Marketplace app (Marketplace → your app → Advanced Settings → Auth)
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
# GHL_SCOPES defaults to the full list in docs/API_AND_INTEGRATIONS.md §6.2 (must match the Marketplace app)
# HighLevel webhook public keys (PEM, "\n" escapes allowed) from the HighLevel webhook docs
GHL_WEBHOOK_ED25519_PUBLIC_KEY=
GHL_WEBHOOK_PUBLIC_KEY=

# ── AI assistant & agency custom domains ─────────────────────────────────────
# COPILOT_MODEL=gemini-2.5-flash     # platform default (uses GEMINI_API_KEY)
# COPILOT_DAILY_LIMIT=300            # assistant messages per workspace per day
# CLOUDFLARE_API_TOKEN=              # optional: auto-TLS for agency domains (Cloudflare for SaaS)
# CLOUDFLARE_ZONE_ID=

# ── AI Call Center (keys are per account, entered in the app) ─────────────────
# VOICE_AGENT_MODEL=gpt-4o
# VOICE_GRADER_MODEL=gpt-4o-mini
# VOICE_SWEEP_INTERVAL_SEC=60
# CALL_RETENTION_DAYS=365
# CRON_SECRET=                       # optional: external trigger for /api/voice/cron/sweep

# ── HR module (MongoDB, one database per workspace) ──────────────────────────
# Leave empty to run without HR. deploy.sh sets mongodb://127.0.0.1:27017 on OCI.
HRMS_MONGODB_URI=
# HRMS_MONGODB_POOL_SIZE=10
# HRMS_UPLOAD_DIR=uploads/hrms      # used when R2_* is not set
# HRMS_WORKER=true                  # false on extra API replicas

# ── Online stores (hosted WooCommerce + connected stores) ────────────────────
# Store servers are added in Super Admin → Online stores (deploy-store-host.sh).
# STORES_CALLBACK_URL=               # address stores use to reach this API; default PUBLIC_APP_URL
# STORES_WORKER=true                 # false on extra API replicas (jobs are safe on several anyway)
# CLOUDFLARE_API_TOKEN=              # optional: Cloudflare for SaaS custom hostnames (SSL for SaaS: Edit)
# CLOUDFLARE_ZONE_ID=                # the zone that serves the store domain

# ── Audit log ────────────────────────────────────────────────────────────────
# AUDIT_LOG_ENABLED=true
# AUDIT_LOG_RETENTION_DAYS=365       # 0 = keep forever

# ── Optional services ────────────────────────────────────────────────────────
REDIS_URL=                           # BullMQ queue for the website crawler
LOG_LEVEL=info

# ── Hosting modes ────────────────────────────────────────────────────────────
# SERVE_STATIC=true                  # API also serves dashboard + marketing (Render, Docker)
# OMNICORE_API_ORIGIN=https://…      # Vercel build only: where /api is proxied

# Dashboard: keep relative for same-origin cookies and sockets.
VITE_API_URL=/api
