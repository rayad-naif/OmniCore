# ─── Atelier OmniCore — Environment Variables Example ─────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=8080
PUBLIC_APP_URL=https://your-domain.com
ALLOWED_ORIGINS=https://your-domain.com

# ── Database (PostgreSQL 15+ with pgvector) ──────────────────────────────────
DATABASE_URL=postgres://user:password@localhost:5432/omnicore

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_here_min_64_chars

# Cookie security — set to 'false' when running without HTTPS (e.g. self-hosted HTTP)
# Leave unset or 'true' when behind HTTPS
COOKIE_SECURE=true

# ── AI — Google Gemini ────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Billing — Paddle ─────────────────────────────────────────────────────────
BILLING_PROVIDER=paddle
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=your_paddle_api_key_here
PADDLE_WEBHOOK_SECRET=your_paddle_webhook_secret_here
PADDLE_STARTER_PRICE_ID=pri_your_starter_price_id
PADDLE_GROWTH_PRICE_ID=pri_your_growth_price_id

# ── Cloudflare R2 (file storage) ─────────────────────────────────────────────
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_bucket_name

# ── Super Admin ───────────────────────────────────────────────────────────────
SUPER_ADMIN_EMAIL=admin@your-domain.com

# ── Session (optional — used by some middleware) ──────────────────────────────
SESSION_SECRET=your_session_secret_here_min_32_chars
